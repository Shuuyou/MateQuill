# Real credentials belong in environment variables / deployment Secrets only.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
# Optional private OpenAPI knowledge-base ID, provided by the authorized user.
IMA_KB_ID=
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Optional content role: set all three together; all empty preserves LLM_*.
# The content role uses the existing workflow budget, without provider fallback.
CONTENT_BASE_URL=
CONTENT_API_KEY=
CONTENT_MODEL=
IMAGE_BASE_URL=https://api.openai-next.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5
# Optional visual reviewer, using the image provider's chat/completions endpoint.
IMAGE_REVIEW_MODEL=
# Speech transcription through an OpenAI-compatible audio endpoint.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
# Docker / public server MUST keep this disabled.
ALLOW_LOCAL_SETTINGS=0
# PostgreSQL: provision roles and migrate separately; never use an owner URL here.
MATEQUILL_DATABASE_URL=
# Used only by the migration command, not the normal service.
MATEQUILL_MIGRATION_DATABASE_URL=
MATEQUILL_ALLOWED_ORIGINS=http://127.0.0.1:3003,http://localhost:3003
MATEQUILL_COOKIE_SECURE=0
MATEQUILL_DAILY_CREATIONS=100
MATEQUILL_BUSINESS_TIMEZONE=Asia/Shanghai
# Optional canonical HTTPS origin for a reverse-proxied public deployment.
MATEQUILL_PUBLIC_URL=
# Optional official enterprise messaging workers; keep real values in ignored runtime/messaging.env.
# python scripts/run_messaging.py --channel wecom --env-file runtime/messaging.env
MATEQUILL_WECOM_BOT_ID=
MATEQUILL_WECOM_BOT_SECRET=
MATEQUILL_FEISHU_APP_ID=
MATEQUILL_FEISHU_APP_SECRET=
MATEQUILL_FEISHU_BOT_OPEN_ID=
MATEQUILL_FEISHU_ENCRYPT_KEY=
MATEQUILL_FEISHU_VERIFICATION_TOKEN=
MATEQUILL_DINGTALK_CLIENT_ID=
MATEQUILL_DINGTALK_CLIENT_SECRET=
# Trusted group mapping only: {"connection_id:chat_id":{"tenant_id":"...","store_id":"..."}}
MATEQUILL_MESSAGING_GROUP_SCOPES={}
# Canonical HTTPS origin used in short-lived, confirmation-required editing links.
MATEQUILL_MESSAGING_WEB_ORIGIN=
# Optional semantic comparison of explicitly shared editorial plans only.
# Keep unset to use the explicitly reported deterministic feature fallback.
DIVERSITY_EMBEDDING_BASE_URL=
DIVERSITY_EMBEDDING_MODEL=text-embedding-3-large
DIVERSITY_EMBEDDING_API_KEY=
