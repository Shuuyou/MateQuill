# Real credentials belong in environment variables / deployment Secrets only.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
# Optional private OpenAPI knowledge-base ID, provided by the authorized user.
IMA_KB_ID=
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
IMAGE_BASE_URL=https://api.openai-next.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5
# Optional visual reviewer, using the image provider's chat/completions endpoint.
IMAGE_REVIEW_MODEL=
# Speech transcription through an OpenAI-compatible audio endpoint.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
# Docker / public server MUST keep this disabled.
ALLOW_LOCAL_SETTINGS=0
# PostgreSQL: provision roles and migrate separately; never use an owner URL here.
MATEQUILL_DATABASE_URL=
# Used only by the migration command, not the normal service.
MATEQUILL_MIGRATION_DATABASE_URL=
MATEQUILL_ALLOWED_ORIGINS=http://127.0.0.1:3003,http://localhost:3003
MATEQUILL_COOKIE_SECURE=0
MATEQUILL_DAILY_CREATIONS=100
